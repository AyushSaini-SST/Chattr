# Runtime: development | test | production
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (required)
MONGODB_URI=

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Origin of the web app. Cookies and Socket.IO are scoped to it.
CLIENT_URL=http://localhost:5173
# Optional extra origins (Vercel preview deployments, staging), comma-separated.
CLIENT_URL_ALLOWLIST=

# Optional: enables avatar and post image uploads when all three are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
